# Token da API do Portal da Transparência (cadastro gratuito por e-mail em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email ).
# Fica SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
PORTAL_TRANSPARENCIA_TOKEN=

# Fração do limite oficial de requisições a usar (0.8 = 320/min de dia, 560/min de madrugada)
PORTAL_MARGEM_LIMITE=0.8
# Tempo de cache das respostas da API (segundos)
PORTAL_CACHE_TTL_SEGUNDOS=3600

# Diretório dos agregados gerados pelo ETL (padrão: data/agregados)
# DADOS_DIR=

# true = usa os DADOS DE DEMONSTRAÇÃO (fictícios) de data/demo, com aviso permanente na tela
DADOS_DEMONSTRACAO=false
